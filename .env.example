# Public frontend configuration (safe to commit — no secrets).
#
# The platform API lives in backend/ and runs on :3001 during development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# The same public app id as the backend's PRIVY_APP_ID. It is a public
# identifier (safe in the browser); the matching secret stays server-side.
NEXT_PUBLIC_PRIVY_APP_ID=
